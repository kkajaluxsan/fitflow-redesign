# ---------- Core API (NestJS) ----------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://fitflow:password@localhost:5432/fitflow
DB_SSL=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth0 ----------
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.fitflow.app
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ---------- AI microservice (FastAPI) ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# ---------- AWS ----------
AWS_REGION=eu-west-1
S3_MEDIA_BUCKET=fitflow-media-dev
SQS_EVENTS_QUEUE_URL=

# ---------- Push notifications ----------
FCM_SERVER_KEY=
APNS_KEY_ID=

# ---------- Observability ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
